# Security-Header. Document Root ist public/, deshalb gelten die Header
# aus der übergeordneten .htaccess hier nicht. PHP setzt dieselben Header
# zusätzlich, damit sie auch ohne mod_headers ankommen.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# Saubere URLs für öffentliche Seiten.
# /faq liefert faq.php intern aus. Ein direkter GET auf faq.php
# geht per 301 auf /faq. Document Root ist public/.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Kanonische Adressen, nur GET/HEAD.
    # POST bleibt liegen, damit Formulare ihre Daten nicht verlieren.
    # Interne Endpunkte und Token-Seiten stehen nicht in der Slug-Liste
    # und behalten ihre Dateiendung.
    # Wenn Plesk oder nginx die Anfrage vor Apache annimmt, gilt diese Datei nicht.
    # Dann zieht die gleiche Logik in PHP (seo_legacy_redirect_target), und www
    # muss zusätzlich in Plesk auf xn--wichtl-gua.ch zeigen.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP_HOST} ^(www\.)?(xn--wichtl-gua\.ch|wichtlä\.ch)(?::\d+)?$ [NC]
    RewriteRule ^index\.php$ https://xn--wichtl-gua.ch/ [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP_HOST} ^(www\.)?(xn--wichtl-gua\.ch|wichtlä\.ch)(?::\d+)?$ [NC]
    RewriteRule ^(en|fr)/index\.php$ https://xn--wichtl-gua.ch/$1/ [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP_HOST} ^(www\.)?(xn--wichtl-gua\.ch|wichtlä\.ch)(?::\d+)?$ [NC]
    RewriteRule ^(faq|was-ist-wichteln|impressum|datenschutz|wichtel-ideen|firmenwichteln-tipps|ueber-uns|unterstuetzen|firmen-premium|create_group|admin-link)\.php$ https://xn--wichtl-gua.ch/$1 [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP_HOST} ^(www\.)?(xn--wichtl-gua\.ch|wichtlä\.ch)(?::\d+)?$ [NC]
    RewriteRule ^(en|fr)/(faq|was-ist-wichteln|impressum|datenschutz|wichtel-ideen|firmenwichteln-tipps|ueber-uns|unterstuetzen|firmen-premium|create_group|admin-link)\.php$ https://xn--wichtl-gua.ch/$1/$2 [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP_HOST} ^www\.(xn--wichtl-gua\.ch|wichtlä\.ch)(?::\d+)?$ [NC]
    RewriteRule ^ https://xn--wichtl-gua.ch%{REQUEST_URI} [R=301,L]

    RewriteRule ^(en|fr)/?$ index.php?lang=$1 [L,QSA]
    RewriteRule ^(en|fr)/admin-link/?$ /admin-link [R=301,L]
    RewriteRule ^(en|fr)/wichtel-ideen2/?$ /$1/wichtel-ideen [R=301,L,QSA]
    RewriteRule ^(en|fr)/(faq|was-ist-wichteln|impressum|datenschutz|wichtel-ideen|firmenwichteln-tipps|ueber-uns|unterstuetzen|firmen-premium|create_group)/$ /$1/$2 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(en|fr)/([a-z0-9_-]+)$ $2?lang=$1 [L,QSA]

    RewriteRule ^(faq|was-ist-wichteln|impressum|datenschutz|wichtel-ideen|firmenwichteln-tipps|ueber-uns|unterstuetzen|firmen-premium|create_group|admin-link)/$ /$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(faq|was-ist-wichteln|impressum|datenschutz|wichtel-ideen|firmenwichteln-tipps|ueber-uns|unterstuetzen|firmen-premium|create_group|admin-link)$ $1.php [L,QSA]

    RewriteRule ^wichtel-ideen2/?$ /wichtel-ideen [R=301,L,QSA]
</IfModule>
